# Frontend build-time env. Vite reads these at `npm run build`.
# Variables MUST be prefixed with VITE_ to be exposed to client code.
#
# In the recommended single-domain CF Pages topology, leave VITE_API_BASE_URL
# EMPTY: the SPA uses the relative path '/api' and the CF Pages Function
# proxies to main via the Cloudflare Tunnel. No build-time URL coupling.
#
# In dev (`npm run dev`), also empty — vite proxies '/api' to localhost:8080.
#
# Override only if the SPA needs to point at a backend on a different
# origin from the page itself (rare).

VITE_API_BASE_URL=

# Pages Function secrets — DO NOT put them here. Set via:
#   wrangler pages secret put JWT_SECRET
#   wrangler pages secret put CF_ACCESS_CLIENT_ID
#   wrangler pages secret put CF_ACCESS_CLIENT_SECRET
#   wrangler pages secret put OCI_S3_ACCESS_KEY_ID
#   wrangler pages secret put OCI_S3_SECRET_ACCESS_KEY
#
# Non-secret vars (ORIGIN_API_URL, OCI_S3_ENDPOINT, OCI_S3_REGION,
# OCI_BUCKET_NAME) live in wrangler.toml [vars].
